#compdef apt-fast

_APTMGR=apt-get
if [ -n "${PREFIX:-}" ] && [ -f "$PREFIX/etc/apt-fast.conf" ]; then
    source "$PREFIX/etc/apt-fast.conf"
elif [ -f /etc/apt-fast.conf ]; then
    source /etc/apt-fast.conf
fi
_APTMGR="${_APTMGR%% *}"
if ! type "${_APTMGR}" &>/dev/null; then
    _APTMGR=apt-get
fi

compdef apt-fast="${_APTMGR}"
